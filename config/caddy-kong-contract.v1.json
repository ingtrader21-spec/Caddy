{
  "schema": "codestra.caddy-kong-edge.v1",
  "principalRepository": "appolon1908-hue/Caddy",
  "gatewayRepository": "appolon1908-hue/Kong",
  "identityRepository": "appolon1908-hue/Keycloak",
  "writeBoundaryRepository": "appolon1908-hue/Middleware-",
  "referenceRepository": "appolon1908-hue/codestra-production-platform",
  "canonicalHost": "api.codestra.co",
  "kongUpstreamEnvironmentVariable": "CADDY_KONG_UPSTREAM",
  "kongReferenceListener": "127.0.0.1:8000",
  "legacyApiUpstreamEnvironmentVariable": "CADDY_LEGACY_API_UPSTREAM",
  "realtimeUpstreamEnvironmentVariable": "CADDY_REALTIME_UPSTREAM",
  "identityBoundary": {
    "caddyAuthenticatesUsersOrServices": false,
    "authorizationHeaderForwardedToKong": true,
    "caddyCreatesTrustedApplicationIdentityHeaders": false,
    "kongPerformsOidcJwtAndScopePolicy": true,
    "middlewareRevalidatesPrivilegedAuthorization": true
  },
  "kongManagedPathPrefixes": [
    "/api/v1/control",
    "/api/v1/messages",
    "/api/v1/events",
    "/api/v1/results",
    "/api/v1/reconciliation",
    "/api/v1/health",
    "/api/v1/callbacks",
    "/api/v1/automation/policy-check",
    "/api/v1/integration/campaign-actions",
    "/api/v1/integrations/n8n/results",
    "/api/v1/integrations/odoo",
    "/api/v1/odoo",
    "/platform/v1",
    "/v2/automation",
    "/v1/integrations/n8n",
    "/v1/admin/system",
    "/v1/crm",
    "/v1/email",
    "/v1/sms",
    "/v1/webhooks",
    "/v1/intake"
  ],
  "transitionalPaths": [
    "/ws/agent",
    "/api/v1/realtime/sessions",
    "/healthz",
    "/readyz",
    "/version"
  ],
  "migration": {
    "legacyFallbackTemporarilyAllowed": true,
    "fullKongRouteParityRequiredBeforeRemovingFallback": true,
    "runtimeInventoryRequiredBeforeCutover": true,
    "rollbackRehearsalRequiredBeforeCutover": true,
    "productionCutoverAuthorizedBySource": false
  },
  "editorHost": {
    "host": "automation.codestra.co",
    "purpose": "n8n Community Edition editor, human administrative surface",
    "adminCidrEnvironmentVariable": "CADDY_EDITOR_ADMIN_CIDRS",
    "gatewayEnforcesKeycloakBrowserFlow": true,
    "caddyAuthenticatesEditorSessions": false,
    "directUpstreamToN8nAllowed": false,
    "nativeN8nAuthRequiredBehindGateway": true
  },
  "middlewareEdgeContract": {
    "source": "ingtrader21-spec/Middleware-:deploy/public-api-route-contract.json",
    "kongVendoredCopy": "Kong:config/middleware-public-api-route-contract.v1.json",
    "sha256": "c13554ebededa3ba6c39d0408adcd93f33baa941cac905907f6d63d390d93fab",
    "sharedEdgeOperations": 80,
    "deniedOperations": 10,
    "rule": "every shared_edge and denied operation path is covered by kongManagedPathPrefixes; private_only operations never appear at the public edge"
  },
  "identityHeaders": {
    "preservedToKong": [
      "Authorization",
      "X-Correlation-ID",
      "Idempotency-Key",
      "traceparent",
      "tracestate"
    ],
    "deletedBeforeKong": [
      "X-User-ID",
      "X-Username",
      "X-Email",
      "X-Roles",
      "X-Scopes",
      "X-Authenticated-UserID",
      "X-Authenticated-User",
      "X-Authenticated-Client",
      "X-Authenticated-Subject",
      "X-Authenticated-Tenant",
      "X-Authenticated-Campaign",
      "X-Authenticated-Role",
      "X-Authenticated-Email",
      "X-Codestra-Tenant",
      "X-Codestra-Scopes",
      "X-Codestra-Gateway-Secret",
      "X-Internal-Service",
      "X-Admin",
      "X-Consumer-ID",
      "X-Consumer-Username",
      "X-Consumer-Custom-ID",
      "X-Credential-Identifier",
      "X-Anonymous-Consumer"
    ],
    "rule": "Caddy deletes client-asserted identity headers on the Kong handoff and never sets one; Kong mints trusted identity after verification"
  },
  "publicApiDirect": {
    "PUBLIC_API_DIRECT_TO_MIDDLEWARE": 0,
    "PUBLIC_API_DIRECT_TO_ODOO": 0,
    "PUBLIC_API_DIRECT_TO_N8N": 0,
    "rule": "api.codestra.co reaches Middleware, Odoo and N8N only through Kong"
  }
}
