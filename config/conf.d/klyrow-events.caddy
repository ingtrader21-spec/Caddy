# Private Klyrow delivery-event ingress. The application origin is loopback-only;
# this listener is the sole private-network entry point and requires mTLS.
https://middleware-email-events.internal.codestra.agency:18080 {
	bind {$CADDY_PRIVATE_INGRESS_BIND}
	tls /etc/caddy/private/klyrow-events/tls-fullchain.crt /etc/caddy/private/klyrow-events/tls.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/private/klyrow-events/klyrow-client.crt
		}
	}

	request_body {
		max_size 256KB
	}

	@klyrow_event {
		remote_ip {$CADDY_KLYROW_SOURCE_CIDRS}
		method POST
		path /internal/provider-events/klyrow
	}
	handle @klyrow_event {
		reverse_proxy {$CADDY_KLYROW_EVENTS_UPSTREAM} {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond "Forbidden" 403
	}

	log {
		output file /var/log/caddy/klyrow-events-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}
