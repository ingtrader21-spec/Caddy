api.staging.internal.codestra.agency {
	tls internal
	import security_headers
	encode gzip

	reverse_proxy {$CADDY_STAGING_KONG_UPSTREAM} {
		import proxy_common
		header_up Host api.codestra.co
	}

	log {
		output file /var/log/caddy/api-staging-internal-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		import sanitized_access_log
	}
}

n8n.staging.internal.codestra.agency {
	tls internal
	import security_headers
	encode gzip

	@live path /health/live
	handle @live {
		rewrite * /healthz
		reverse_proxy {$CADDY_N8N_STAGING_UPSTREAM} {
			import proxy_common
		}
	}

	@ready path /health/ready
	handle @ready {
		rewrite * /healthz/readiness
		reverse_proxy {$CADDY_N8N_STAGING_UPSTREAM} {
			import proxy_common
		}
	}

	@metadata path /.well-known/codestra-service
	handle @metadata {
		header Content-Type application/json
		respond `{"service":"codestra-n8n","environment":"staging","contract_version":"1.0","live_path":"/health/live","ready_path":"/health/ready"}` 200
	}

	handle {
		reverse_proxy {$CADDY_STAGING_PORTAL_UPSTREAM} {
			import proxy_common
		}
	}

	log {
		output file /var/log/caddy/n8n-staging-internal-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		import sanitized_access_log
	}
}

