bridge-staging.codestra.agency {
	import security_headers
	encode gzip

	route {
		@private_callback path /api/v1/events/vicidial
		respond @private_callback 404

		reverse_proxy {$CADDY_STAGING_KONG_UPSTREAM} {
			import proxy_common
			header_up Host api.codestra.co
		}
	}

	log {
		output file /var/log/caddy/bridge-staging-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		import sanitized_access_log
	}
}
