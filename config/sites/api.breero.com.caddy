# Activation gate: api.breero.com DNS must resolve to the reviewed Caddy host.
# This site always enters through Kong's proxy listener; Kong Admin is never used.
api.breero.com {
	import security_headers
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	@health {
		method GET
		path /health /health/ready
	}
	handle @health {
		reverse_proxy {$CADDY_KONG_UPSTREAM} {
			import proxy_common
		}
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy {$CADDY_KONG_UPSTREAM} {
			import proxy_common
		}
	}

	handle {
		respond "Not Found" 404
	}

	log {
		output file /var/log/caddy/api-breero-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}
