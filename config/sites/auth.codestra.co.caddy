auth.codestra.co {
	import security_headers

	reverse_proxy {$CADDY_KEYCLOAK_UPSTREAM} {
		# Keycloak's runtime gzip cache is read-only in this deployment.
		header_up Accept-Encoding identity
		import proxy_common
	}

	log {
		output file /var/log/caddy/auth-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}
