# Only browser-facing observability applications are public. Prometheus,
# Alertmanager, Loki, Tempo, OTel, Alloy, exporters, and cAdvisor stay private.
graf.codestra.media {
	import security_headers
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	request_header -X-Codestra-Gateway-Secret

	reverse_proxy {$CADDY_GRAFANA_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		stream_timeout 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output file /var/log/caddy/graf-codestra-media-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}

supe.codestra.media {
	import security_headers
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Groups
	request_header -X-Authenticated-Client
	request_header -X-Authenticated-Tenant
	request_header -X-Authenticated-Role
	request_header -X-Codestra-Gateway-Secret

	reverse_proxy {$CADDY_SUPERSET_UPSTREAM} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		flush_interval -1
		stream_timeout 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}

	log {
		output file /var/log/caddy/supe-codestra-media-access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}

bao.codestra.media {
	import security_headers
	encode zstd gzip

	@openbao_allowed remote_ip {$CADDY_OPENBAO_ALLOWED_CIDRS}
	handle @openbao_allowed {
		request_body {
			max_size 2MB
		}

		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Groups
		request_header -X-Authenticated-Client
		request_header -X-Authenticated-Tenant
		request_header -X-Authenticated-Role
		request_header -X-Codestra-Gateway-Secret

		reverse_proxy {$CADDY_OPENBAO_UPSTREAM} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			flush_interval -1
			stream_timeout 5m
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		respond "Forbidden" 403
	}

	log {
		output file /var/log/caddy/bao-codestra-media-access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		import sanitized_access_log
	}
}
