{
  "schema": "codestra.caddy-kong-edge.v2",
  "principalRepository": "appolon1908-hue/Caddy",
  "gatewayRepository": "appolon1908-hue/Kong",
  "identityRepository": "appolon1908-hue/Keycloak",
  "writeBoundaryRepository": "appolon1908-hue/Middleware-",
  "referenceRepository": "appolon1908-hue/codestra-production-platform",
  "canonicalHost": "api.codestra.co",
  "legacyHost": "api.codestra.agency",
  "kongUpstreamEnvironmentVariable": "CADDY_KONG_UPSTREAM",
  "realtimeUpstreamEnvironmentVariable": "CADDY_REALTIME_UPSTREAM",
  "identityBoundary": {
    "caddyAuthenticatesUsersOrServices": false,
    "authorizationHeaderForwardedToKong": true,
    "caddyCreatesTrustedApplicationIdentityHeaders": false,
    "kongPerformsOidcJwtAndScopePolicy": true,
    "middlewareRevalidatesPrivilegedAuthorization": true
  },
  "kongManagedPathPrefixes": [
    "/api/v1/control/messages",
    "/api/v1/control/campaigns",
    "/api/v1/control/agents",
    "/api/v1/control/memberships",
    "/api/v1/control/adapters",
    "/api/v1/messages",
    "/api/v1/events",
    "/api/v1/results",
    "/api/v1/reconciliation",
    "/api/v1/health",
    "/v1/integrations/n8n",
    "/v1/admin/system",
    "/v1/crm",
    "/v1/email",
    "/v1/sms",
    "/v1/webhooks",
    "/v1/intake"
  ],
  "blockedUntilImplemented": [
    {
      "pathPrefix": "/api/v1/control/callbacks",
      "reason": "Kong declares the callback control route but current Middleware main has no matching API implementation"
    },
    {
      "pathPrefix": "/api/v1/callbacks",
      "reason": "Kong declares the callback read route but current Middleware main has no matching API implementation"
    },
    {
      "pathPrefix": "/api/v1/automation/policy-check",
      "reason": "Kong declares the campaign policy route but current Middleware main has no matching API implementation"
    },
    {
      "pathPrefix": "/api/v1/integrations/n8n/results",
      "reason": "Kong declares the campaign result route but current Middleware main has no matching API implementation"
    }
  ],
  "explicitCompatibilityPaths": [
    "/ws/agent",
    "/api/v1/realtime/sessions",
    "/healthz",
    "/readyz",
    "/version"
  ],
  "publicReadOnlyCanary": {
    "host": "api.codestra.co",
    "paths": [
      "/healthz",
      "/readyz",
      "/version"
    ],
    "methods": [
      "GET",
      "HEAD"
    ],
    "upstreamAuthority": "websocket-gateway",
    "kongManaged": false,
    "writeMethodsDeniedAtEdge": true
  },
  "legacyApiFallback": {
    "enabled": false,
    "unrestrictedCatchAllAllowed": false,
    "unknownPathsReturn": 404
  },
  "migration": {
    "runtimeInventoryRequiredBeforeCutover": true,
    "rollbackRehearsalRequiredBeforeCutover": true,
    "productionCutoverAuthorizedBySource": false
  },
  "editorHost": {
    "host": "automation.codestra.co",
    "purpose": "n8n Community Edition editor",
    "adminCidrEnvironmentVariable": "CADDY_EDITOR_ADMIN_CIDRS",
    "gateway": "Kong",
    "gatewayEnforcesKeycloakBrowserFlow": true,
    "caddyAuthenticatesEditorSessions": false,
    "directUpstreamToN8nAllowed": false,
    "nativeN8nAuthRequiredBehindGateway": true
  }
}
