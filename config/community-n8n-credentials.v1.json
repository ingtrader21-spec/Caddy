{
  "schema": "codestra.n8n-community-credentials.v1",
  "secret_values_in_repository": false,
  "human_identity": {
    "provider": "Keycloak",
    "required_any_roles": ["n8n_operator", "n8n_admin"],
    "oauth2_proxy_enforces_roles": true
  },
  "editor_gateway_identity": {
    "client_id": "n8n-editor-gateway",
    "grant": "authorization_code_pkce",
    "secret_source": "root-owned-docker-secret-files",
    "rotation_days": 90
  },
  "runtime_identity": {
    "client_id": "n8n-automation",
    "grant": "client_credentials",
    "credential_store": "n8n",
    "credential_alias": "Codestra Middleware Runtime",
    "owner": "n8n-service-owner",
    "audience": "middleware-api",
    "allowed_base_url": "https://api.codestra.co/v1/integrations/n8n",
    "rotation_days": 90,
    "backup_owner_required": true,
    "revocation_runbook_required": true
  },
  "local_owner": {
    "purpose": "bootstrap-and-break-glass-only",
    "shared_runtime_credential": false
  }
}
