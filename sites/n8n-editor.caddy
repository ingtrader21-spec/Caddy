# Community-edition n8n editor boundary. oauth2-proxy performs Keycloak OIDC
# and enforces membership of /automation-editors before Caddy reaches n8n.
{$EDITOR_HOST} {
	import security_headers

	route {
		@never_public path /webhook-test* /form-test* /rest/owner/setup* /rest/owner/dismiss-banner*
		respond @never_public 404

		@runtime_public path /webhook/* /webhook-waiting/* /form/*
		handle @runtime_public {
			reverse_proxy {$N8N_EDITOR_UPSTREAM}
		}

		handle_path /oauth2/* {
			reverse_proxy {$N8N_OAUTH2_PROXY_UPSTREAM}
		}

		handle {
			forward_auth {$N8N_OAUTH2_PROXY_UPSTREAM} {
				uri /oauth2/auth
				copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
			}
			reverse_proxy {$N8N_EDITOR_UPSTREAM} {
				header_up -Authorization
				header_up -X-Auth-Request-Access-Token
				header_up -X-Forwarded-Access-Token
			}
		}
	}
}
