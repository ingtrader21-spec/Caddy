# Canonical shared API-edge source owned by appolon1908-hue/Caddy.
# Historical reference: appolon1908-hue/codestra-production-platform
# ref: release/production-activation
# path: operations/caddy/api.codestra.co.caddy
#
# Caddy terminates the public edge. Kong owns API authentication, authorization,
# rate/route policy and the handoff to Middleware. Transitional legacy/realtime
# upstreams remain explicit until their equivalent Kong routes are accepted.
api.codestra.co {
	import security_headers
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	route {
		# BEGIN GENERATED MIDDLEWARE CONTRACT ROUTES
		# Generated from config/middleware-public-api-route-contract.v1.json.
		# Caddy selects exact method+path pairs; Kong owns authentication and policy.
		@canonical_get {
			method GET
			path_regexp ^(/api/v1/callbacks|/api/v1/integrations/n8n/results/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/api/v1/integrations/odoo/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/api/v1/integrations/odoo/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/desired\-state|/platform/v1/activity|/platform/v1/activity/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/agents/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/presence|/platform/v1/agents/presence|/platform/v1/calls|/platform/v1/calls/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/campaigns|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/channels|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/health|/platform/v1/campaigns/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/members|/platform/v1/email/identities|/platform/v1/email/production/audit|/platform/v1/email/production/quotas|/platform/v1/email/production/readiness|/platform/v1/email/production/status|/platform/v1/hosts|/platform/v1/hosts/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/me/presence|/platform/v1/queues|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/calls|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/members|/platform/v1/queues/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/metrics|/platform/v1/repositories|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/coverage|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/dependencies|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/deployments|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/endpoints|/platform/v1/session/context|/platform/v1/sms/identities|/platform/v1/sync/reconciliations/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/sync/status|/platform/v1/telephony/assignments|/platform/v1/tenants|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/campaigns|/platform/v1/tenants/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/health|/platform/v1/tenants/authorized|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/campaigns|/platform/v1/users/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/entitlements|/v2/automation/approvals/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/capabilities/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/commands/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$
		}
		handle @canonical_get {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}

		@canonical_post {
			method POST
			path_regexp ^(/api/v1/automation/policy\-check|/api/v1/control/callbacks|/api/v1/integrations/n8n/results|/api/v1/odoo/events|/platform/v1/agent\-provisioning/requests|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reactivate|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/reconcile|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/revoke|/platform/v1/agent\-provisioning/requests/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/suspend|/platform/v1/email/production/activate|/platform/v1/email/production/authorize|/platform/v1/email/production/kill\-switch|/platform/v1/email/production/revoke|/platform/v1/integrations/github/events|/platform/v1/runtime/observations|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/contract\-refresh|/platform/v1/services/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/telemetry\-profile|/platform/v1/session/context/select|/platform/v1/sync/reconciliations|/platform/v1/telemetry/heartbeats|/v2/automation/approvals|/v2/automation/commands|/v2/automation/dead\-letters/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/replay|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/complete|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/fail|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/heartbeat|/v2/automation/jobs/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/steps|/v2/automation/jobs/claim|/v2/automation/jobs/reconcile)$
		}
		handle @canonical_post {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}

		# END GENERATED MIDDLEWARE CONTRACT ROUTES

		# Retired campaign-control surfaces. Kong has no route for them and answers
		# 404; they are listed so the legacy fallback below can never serve them.
		@retired_campaign_control path /api/v1/integrations/odoo/campaign-actions* /api/v1/integrations/odoo/campaign-commands* /api/v1/integration/campaign-actions* /api/v1/odoo/campaign-actions*
		handle @retired_campaign_control {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}

		# Paths already represented by reviewed Kong source. Preserve the public
		# host because Kong uses host-based routing for api.codestra.co. The
		# integration prefixes are repeated here so that an unsupported method on
		# a service-JWT route is refused by Kong, never by the legacy fallback.
		@kong path /v2/automation* /platform/v1* /api/v1/odoo/events* /api/v1/control* /api/v1/messages* /api/v1/events* /api/v1/results* /api/v1/reconciliation* /api/v1/health* /api/v1/callbacks* /api/v1/automation/policy-check /api/v1/integrations/n8n/results* /api/v1/integrations/odoo/campaigns* /v1/integrations/n8n* /v1/admin/system* /v1/crm* /v1/email* /v1/sms* /v1/webhooks* /v1/intake*
		handle @kong {
			reverse_proxy {$CADDY_KONG_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}

		# Transitional compatibility only. These paths are not yet proven to have
		# equivalent accepted Kong routes in the reviewed source inventory.
		@realtime path /ws/agent /api/v1/realtime/sessions /healthz /readyz /version
		handle @realtime {
			reverse_proxy {$CADDY_REALTIME_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}

		# Transitional legacy API fallback. The Caddy principal-source migration is
		# complete only when this fallback is no longer required and Kong owns the
		# corresponding route contracts.
		handle {
			reverse_proxy {$CADDY_LEGACY_API_UPSTREAM} {
				header_up Host {host}
				header_up X-Real-IP {remote_host}
			}
		}
	}

	log {
		output file /var/log/caddy/api-codestra-co-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			request>headers>Apikey delete
			request>headers>X-Api-Key delete
			request>headers>Authorization delete
			request>uri query {
				delete apikey
			}
		}
	}
}
